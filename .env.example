# ── AWS Credentials (required) ────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1

# ── Bright Data Web Unlocker (optional) ───────────────────────────────────────
# If not set, the agent falls back to the hardcoded reference policy.
# Get credentials at: https://brightdata.com/products/web-unlocker
BRIGHTDATA_API_TOKEN=your_brightdata_api_token_here
BRIGHTDATA_ZONE=hackathon_unlocker

# ── Coverage Policy URL (optional) ────────────────────────────────────────────
# Public URL the agent fetches via Bright Data. Defaults to Aetna's
# checkpoint-inhibitor coverage policy (publicly accessible).
COVERAGE_POLICY_URL=https://www.aetna.com/cpb/medical/data/700_799/0770.html
